PORT=3000
PAYCORE_INTEGRATION_DB_URL=postgresql://paycore:paycore@127.0.0.1:5432/paycore
PAYCORE_INTEGRATION_DB_SCHEMA=integration_api
PAYCORE_FINANCIAL_CORE_URL=http://127.0.0.1:8080
PAYCORE_FINANCIAL_CORE_TIMEOUT_MS=3000
PAYCORE_AUTH_JWT_SECRET=paycore-lab-dev-only-secret-change-me-0123456789abcdef
PAYCORE_AUTH_JWT_ISSUER=paycore-lab
PAYCORE_RATE_LIMIT_PER_MINUTE=120
PAYCORE_PARTNERS=[{"id":"partner-alpha","name":"Parceiro Alpha","apiKey":"alpha-dev-only-key","ownerId":"11111111-1111-4111-8111-111111111111"}]

# Entrega de webhooks (card 5). Em produção mantenha o worker ligado e o Kafka
# explicitamente habilitado; o laboratório local pode usar um receptor em loopback.
PAYCORE_WEBHOOK_WORKER_ENABLED=1
PAYCORE_WEBHOOK_POLL_INTERVAL_MS=1000
PAYCORE_WEBHOOK_BATCH_SIZE=10
PAYCORE_WEBHOOK_MAX_ATTEMPTS=6
PAYCORE_WEBHOOK_TIMEOUT_MS=5000
PAYCORE_WEBHOOK_BACKOFF_BASE_MS=1000
PAYCORE_WEBHOOK_BACKOFF_MAX_MS=60000
PAYCORE_WEBHOOK_LOCK_TTL_MS=30000
# 1 apenas para laboratório/demonstração com receptor em localhost ou rede privada.
PAYCORE_WEBHOOK_ALLOW_PRIVATE_NETWORKS=0
PAYCORE_WEBHOOK_KAFKA_ENABLED=0
PAYCORE_WEBHOOK_KAFKA_BROKERS=127.0.0.1:9092
PAYCORE_WEBHOOK_KAFKA_GROUP_ID=paycore-integration-webhooks
PAYCORE_WEBHOOK_KAFKA_CLIENT_ID=paycore-integration-api
